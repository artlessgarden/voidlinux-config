// 左主列 + 右 tabbed 列（放松版：最多两块内容，其余进右 tab）
// 源文件：voidlinux-config/home/.config/niri/config.kdl
// 热重载：niri 改配置会自动；或 niri msg action load-config-file

input {
    keyboard { repeat-delay 200; repeat-rate 30; }
    touchpad {
        tap
        dwt
        dwtp
        natural-scroll
        scroll-method "two-finger"
        scroll-factor 0.85
        accel-profile "adaptive"
        accel-speed 0.2
        tap-button-map "left-right-middle"
        click-method "clickfinger"
        drag true
        drag-lock
    }
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
    mouse { accel-speed 0.2; }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    // 左主约 62%，右栏其余；单列时居中
    preset-column-widths {
        proportion 0.382
        proportion 0.618
        proportion 1.0
    }
    default-column-width { proportion 0.618; }
    background-color "transparent"
    always-center-single-column
    center-focused-column "never"
    gaps 0
    focus-ring { off; }

    // 新列默认 tab；单窗时隐藏指示条
    default-column-display "tabbed"
    tab-indicator {
        hide-when-single-tab
        place-within-column
        position "top"
        gap 4
        width 4
        length total-proportion=1.0
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        draw-behind-window true
        color "#000000ff"
        inactive-color "#00000054"
    }
}

prefer-no-csd
hotkey-overlay { skip-at-startup; }
window-rule { open-floating false; }

window-rule {
    match app-id="^foot$" title="^termfilechooser$"
    open-floating true
    open-focused true
    default-column-width { fixed 960; }
    default-window-height { fixed 720; }
}

output "eDP-1" {
    scale 1.5
    mode "2560x1600@60"
}

layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

gestures { hot-corners { off; }; }
animations { off; }

spawn-at-startup "pipewire"
spawn-at-startup "swaybg" "-i" "/home/xiang/.config/niri/bg4.jpg"
spawn-at-startup "fcitx5"
spawn-at-startup "swayidle" "-w" \
    "timeout" "180" "swaylock -f -i /home/xiang/.config/niri/bg3.jpg" \
    "timeout" "240" "niri msg action power-off-monitors"
spawn-at-startup "foot"
spawn-at-startup "wlsunset" "-l" "20" "-L" "100"
spawn-at-startup "mouseless"

binds {
    // 应用：经 niri-spawn 尽量进右 tab 列
    Mod+a repeat=false { spawn "/home/xiang/.local/bin/niri-spawn" "foot"; }
    Mod+Return repeat=false { spawn "/home/xiang/.local/bin/niri-spawn" "foot"; }
    Mod+c repeat=false { spawn "/home/xiang/.local/bin/niri-spawn" "helium"; }
    Mod+n repeat=false { spawn "/home/xiang/.local/bin/niri-spawn" "foot" "vis" "/home/xiang/Drafts/memo/inbox.md"; }

    Mod+w repeat=false { spawn "wl-kbptr" "-o" "modes=floating,click" "-o" "mode_floating.source=detect"; }
    Mod+escape repeat=false { power-off-monitors; }
    Mod+v repeat=false { toggle-overview; }
    Mod+p repeat=false { spawn-sh "grim -g \"$(slurp)\" - | satty -f - --copy-command wl-copy --early-exit copy"; }
    Mod+ctrl+p repeat=false { spawn-sh "grim - | satty -f - --copy-command wl-copy --early-exit copy"; }
    Mod+r repeat=false { switch-preset-column-width; }

    // Super+1 左右列循环；Super+2 右列 tab 上下循环
    Mod+1 cooldown-ms=70 { focus-column-right-or-first; }
    Mod+2 cooldown-ms=70 { focus-window-down-or-top; }

    // 保留原 hjkl 风格
    Mod+s cooldown-ms=70 { focus-column-left; }
    Mod+f cooldown-ms=70 { focus-column-right; }
    Mod+e cooldown-ms=70 { focus-window-or-workspace-up; }
    Mod+d cooldown-ms=70 { focus-window-or-workspace-down; }

    Mod+ctrl+s cooldown-ms=70 { move-column-left; }
    Mod+ctrl+f cooldown-ms=70 { move-column-right; }
    Mod+ctrl+e cooldown-ms=70 { move-window-up-or-to-workspace-up; }
    Mod+ctrl+d cooldown-ms=70 { move-window-down-or-to-workspace-down; }

    Mod+alt+e cooldown-ms=70 { move-column-to-workspace-up; }
    Mod+alt+d cooldown-ms=70 { move-column-to-workspace-down; }

    // 手动收进左/右列（脚本失败时用）
    Mod+alt+s cooldown-ms=70 { consume-or-expel-window-left; }
    Mod+alt+f cooldown-ms=70 { consume-or-expel-window-right; }

    // 当前列切 tab / 普通
    Mod+t repeat=false { toggle-column-tabbed-display; }

    Mod+q repeat=false { close-window; }
    Mod+Shift+f repeat=false { fullscreen-window; }

    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "2%-"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "2%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "2%-"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "2%+"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    Mod+WheelScrollDown cooldown-ms=70 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=70 { focus-workspace-up; }
    Mod+MouseRight { focus-column-right; }
    Mod+MouseLeft { focus-column-left; }
}
