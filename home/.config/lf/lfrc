# lf：l / → / Enter = 内置 open（目录进入，文件走 cmd open）— 这是唯一稳的做法
# 同步 ${{ }} 里调 lf -remote 会卡住（闪一下没反应）；fzf 跳转才用 &{{ + remote
# 门户选目录：wrapper 把 Enter 绑成 portal-accept; quit

set shell sh
set shellopts '-eu'
set ifs "\n"

set preview
set previewer ~/.config/lf/preview
set hidden
set ignorecase
set smartcase
set info size:time
set scrolloff 3
set mouse
set period 1

# 仅文件；目录由内置 open cd
cmd open ${{
	set -f
	case $(file --mime-type -Lb -- "$f") in
	text/*|application/json|application/xml|application/javascript|\
	application/x-sh|application/x-shellscript|application/x-zerosize|inode/x-empty)
		vis -- $fx
		;;
	image/*)
		imv -- $fx >/dev/null 2>&1 &
		;;
	video/*|audio/*)
		mpv -- $fx >/dev/null 2>&1 &
		;;
	application/pdf)
		zathura -- $fx >/dev/null 2>&1 &
		;;
	*)
		for path in $fx; do
			xdg-open "$path" >/dev/null 2>&1 &
		done
		;;
	esac
}}

map l open
map <right> open
map <enter> open

map a :push %touch<space>
map A :push %mkdir<space>

# 回收站（Freedesktop / gio → ~/.local/share/Trash）
# D 丢进回收站；gT 打开；U 恢复当前项；gE 清空（需确认）
# 永久删仍用 :delete
cmd trash ${{
	set -f
	gio trash -- $fx
}}
map D trash

map gT cd ~/.local/share/Trash/files

cmd trash-restore !{{
	set -f
	trash-restore $fx
}}
map U trash-restore

cmd trash-empty !trash-empty
map gE trash-empty

# 门户选目录用（写 XDG 路径；quit 在 map 里链式调用）
cmd portal-accept ${{
	set -f
	[ -n "${LF_XDG_OUT:-}" ] || exit 0
	[ -d "$f" ] || exit 0
	printf '%s\n' "$f" > "$LF_XDG_OUT"
}}

# fzf / rg：必须同步 ${{ 才能抢 tty；选完后再 remote（和进目录那种一上来 remote 不同）
cmd fzf_jump ${{
	set -f
	target=$(/usr/bin/fd --type f --type d --hidden --follow --exclude .git 2>/dev/null | /usr/bin/fzf) || exit 0
	[ -n "$target" ] || exit 0
	escaped=$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')
	lf -remote "send $id select \"$escaped\""
}}
map <c-f> fzf_jump

cmd fzf_rg ${{
	set -f
	pattern=$1
	[ -n "$pattern" ] || exit 0
	target=$(/usr/bin/rg -l --hidden --glob '!.git' -- "$pattern" 2>/dev/null | /usr/bin/fzf \
		--preview "/usr/bin/rg -n --color=always -- \"$pattern\" {} 2>/dev/null | head -100") || exit 0
	[ -n "$target" ] || exit 0
	escaped=$(printf '%s' "$target" | sed 's/\\/\\\\/g;s/"/\\"/g')
	lf -remote "send $id select \"$escaped\""
}}
map <c-g> :push :fzf_rg<space>

cmd extract ${{
	set -f
	case $f in
	*.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf "$f" ;;
	*.tar.gz|*.tgz) tar xzvf "$f" ;;
	*.tar.xz|*.txz) tar xJvf "$f" ;;
	*.zip) unzip "$f" ;;
	*.7z) 7z x "$f" ;;
	*) printf 'unknown archive: %s\n' "$f" ;;
	esac
}}

cmd tar ${{
	set -f
	mkdir "$1"
	cp -r $fx "$1"
	tar czf "$1.tar.gz" "$1"
	rm -rf "$1"
}}

cmd zip ${{
	set -f
	mkdir "$1"
	cp -r $fx "$1"
	zip -r "$1.zip" "$1"
	rm -rf "$1"
}}
