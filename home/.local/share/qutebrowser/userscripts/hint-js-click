#!/usr/bin/env python3
"""标记可点 → hint；模式写入 data 目录（hint 的 maxsplit=2 不能带额外参数）。"""
from __future__ import annotations

import os
import sys
import time
from pathlib import Path

FIFO = os.environ["QUTE_FIFO"]
DATA = Path(os.environ.get("QUTE_DATA_DIR", Path.home() / ".local/share/qutebrowser"))
MODE_FILE = DATA / "hint-click-mode"
MODE = (sys.argv[1] if len(sys.argv) > 1 else "current").strip() or "current"


def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def main() -> int:
    MODE_FILE.write_text(MODE, encoding="utf-8")
    cmd("jseval -q -f --world main mark-clickables.js")
    time.sleep(0.08)
    # 不能写成 userscript do-js-click tab —— hint maxsplit=2 会把整段当脚本名
    cmd("hint clickable userscript do-js-click")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
