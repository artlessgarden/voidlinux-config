#!/usr/bin/env python3
"""标记可点 → hint；略等 FIFO 跑完 mark（mark 本身已尽量轻）。"""
from __future__ import annotations

import os
import sys
import time

FIFO = os.environ["QUTE_FIFO"]
MODE = (sys.argv[1] if len(sys.argv) > 1 else "current").strip()


def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def main() -> int:
    cmd("jseval -q -f --world main mark-clickables.js")
    time.sleep(0.08)
    cmd(f"hint clickable userscript do-js-click {MODE}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
