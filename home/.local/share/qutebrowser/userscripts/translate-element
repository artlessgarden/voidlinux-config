#!/usr/bin/env python3
"""hint / 选区：翻译元素文本。短 → 顶栏；长 → 纯译文页（无附加壳）。"""
from __future__ import annotations

import html
import os
import subprocess
import sys
import tempfile
from pathlib import Path

FIFO = os.environ["QUTE_FIFO"]
TEXT = os.environ.get("QUTE_SELECTED_TEXT", "").strip()
TL = os.environ.get("QUTE_TRANS_TARGET", "zh")
TAB_CHARS = 280


def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def warn(msg: str) -> None:
    esc = msg.replace("\\", "\\\\").replace('"', '\\"')
    cmd(f'message-warning "{esc}"')


def info(msg: str) -> None:
    esc = msg.replace("\\", "\\\\").replace('"', '\\"')
    cmd(f'message-info "{esc}"')


def translate(text: str) -> str:
    try:
        r = subprocess.run(
            ["trans", "-b", "-no-auto", f":{TL}"],
            input=text,
            text=True,
            capture_output=True,
            timeout=120,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        warn(f"trans 失败: {e}")
        return ""
    if r.returncode != 0 or not r.stdout.strip():
        return ""
    return r.stdout.strip()


def write_bare(translated: str) -> Path:
    body = "".join(
        f"<p>{html.escape(p)}</p>" for p in translated.split("\n\n") if p.strip()
    )
    doc = f"""<!DOCTYPE html>
<html lang="{html.escape(TL)}"><head><meta charset="utf-8"/></head>
<body style="margin:1.5rem;font:18px/1.65 sans-serif;max-width:42rem">
{body or "<p></p>"}
</body></html>
"""
    path = Path(tempfile.gettempdir()) / f"qute-trans-el-{os.getpid()}.html"
    path.write_text(doc, encoding="utf-8")
    return path.resolve()


def main() -> int:
    if not TEXT:
        warn("没有文本（hint 元素或先选中）")
        return 0
    info("翻译中…")
    out = translate(TEXT)
    if not out:
        warn("翻译失败（检查网络或 trans）")
        return 0

    if len(TEXT) >= TAB_CHARS or len(out) >= TAB_CHARS:
        cmd(f"open -t {write_bare(out)}")
        info("已打开译文")
    else:
        summary = " ".join(out.splitlines())[:400]
        esc = summary.replace("\\", "\\\\").replace('"', '\\"')
        cmd(f'message-info "译: {esc}"')
        try:
            subprocess.run(
                ["wl-copy"], input=out, text=True, check=False, timeout=5
            )
        except (OSError, subprocess.TimeoutExpired):
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
