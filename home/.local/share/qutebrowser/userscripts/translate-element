#!/usr/bin/env python3
"""hint 译元素：在原元素正下方插入译文（实时 DOM，像 ,p 双语条）。

用 gtx / DeepL API，不用 trans。找不到节点时退回底栏。
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

FIFO = os.environ["QUTE_FIFO"]
TEXT = os.environ.get("QUTE_SELECTED_TEXT", "").strip()
TL_RAW = os.environ.get("QUTE_TRANS_TARGET", "zh")
TL = {"zh": "zh-CN", "zh-cn": "zh-CN", "zh_CN": "zh-CN"}.get(TL_RAW, TL_RAW)
DEEPL_KEY = (
    os.environ.get("QUTE_DEEPL_KEY") or os.environ.get("DEEPL_AUTH_KEY") or ""
).strip()


def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def warn(msg: str) -> None:
    esc = msg.replace("\\", "\\\\").replace('"', '\\"')
    cmd(f'message-warning "{esc}"')


def info(msg: str) -> None:
    esc = msg.replace("\\", "\\\\").replace('"', '\\"')
    cmd(f'message-info "{esc}"')


def gtx_translate(text: str) -> str:
    qs = urllib.parse.urlencode(
        {"client": "gtx", "sl": "auto", "tl": TL, "dt": "t", "q": text}
    )
    req = urllib.request.Request(
        "https://translate.googleapis.com/translate_a/single?" + qs,
        headers={"User-Agent": "Mozilla/5.0"},
        method="GET",
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.loads(resp.read().decode("utf-8", errors="replace"))
    parts = data[0] or []
    return "".join(p[0] for p in parts if p and p[0]).strip()


def deepl_translate(text: str) -> str:
    target = "ZH" if TL.lower().startswith("zh") else TL.upper()[:5]
    endpoint = (
        "https://api-free.deepl.com/v2/translate"
        if DEEPL_KEY.endswith(":fx")
        else "https://api.deepl.com/v2/translate"
    )
    body = urllib.parse.urlencode(
        {
            "auth_key": DEEPL_KEY,
            "target_lang": target,
            "preserve_formatting": "1",
            "text": text,
        }
    ).encode("utf-8")
    req = urllib.request.Request(
        endpoint,
        data=body,
        headers={
            "User-Agent": "qute-learn/1.0",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        payload = json.loads(resp.read().decode("utf-8", errors="replace"))
    outs = payload.get("translations") or []
    return (outs[0].get("text") if outs else "").strip()


def translate(text: str) -> str:
    try:
        if DEEPL_KEY:
            return deepl_translate(text)
        return gtx_translate(text)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, ValueError) as e:
        warn(f"翻译失败: {e}")
        return ""


def write_inject_js(orig: str, trans: str) -> Path:
    """写临时 JS：按原文匹配最深元素，在下方插入/更新译文条。"""
    payload = {
        "orig": orig,
        "trans": trans,
    }
    # 用 JSON 塞进 JS，避免引号地狱
    js = f"""
(function() {{
  const P = {json.dumps(payload, ensure_ascii=False)};
  const orig = (P.orig || "").trim();
  const trans = P.trans || "";
  if (!orig || !trans) return "empty";

  const all = Array.from(document.querySelectorAll("body *")).filter((el) => {{
    if (el.closest && el.closest(".qute-live-trans")) return false;
    if (el.classList && el.classList.contains("qute-live-trans")) return false;
    const t = (el.innerText || "").trim();
    return t === orig;
  }});
  // 最深节点：没有其它候选是自己的后代
  let best = all.find((el) => !all.some((o) => o !== el && el.contains(o))) || all[0];
  if (!best) {{
    // 退一步：全文包含且较短的块
    const soft = Array.from(document.querySelectorAll("p,h1,h2,h3,h4,h5,h6,li,td,th,blockquote,pre,figcaption,article,section,div,span"))
      .filter((el) => {{
        if (el.closest && el.closest(".qute-live-trans")) return false;
        const t = (el.innerText || "").trim();
        return t.includes(orig) && t.length < orig.length * 2 + 40;
      }})
      .sort((a, b) => (a.innerText||"").length - (b.innerText||"").length);
    best = soft[0];
  }}
  if (!best) return "miss";

  let box = best.nextElementSibling;
  if (box && box.classList && box.classList.contains("qute-live-trans")) {{
    box.textContent = trans;
    return "update";
  }}
  box = document.createElement("div");
  box.className = "qute-live-trans";
  box.setAttribute("contenteditable", "false");
  box.style.cssText = [
    "margin:0.2em 0 0.65em",
    "padding:0.15em 0 0.15em 0.55em",
    "border-left:3px solid #6cb6ff88",
    "opacity:0.92",
    "font-size:0.95em",
    "line-height:1.55",
    "white-space:pre-wrap",
  ].join(";");
  box.textContent = trans;
  best.insertAdjacentElement("afterend", box);
  try {{ box.scrollIntoView({{ block: "nearest", behavior: "smooth" }}); }} catch (e) {{}}
  return "ok";
}})();
"""
    path = Path(tempfile.gettempdir()) / f"qute-live-trans-{os.getpid()}.js"
    path.write_text(js, encoding="utf-8")
    return path.resolve()


def main() -> int:
    if not TEXT:
        warn("没有文本（hint 点选元素）")
        return 0
    info("翻译中…")
    out = translate(TEXT)
    if not out:
        warn("翻译结果为空")
        return 0

    js_path = write_inject_js(TEXT, out)
    # -q 安静；-f 读文件；main 世界才能稳改页面 DOM
    cmd(f"jseval -q -f --world main {js_path}")
    info("已插到元素下方（再 ,e 同段会更新）")
    try:
        subprocess.run(["wl-copy"], input=out, text=True, check=False, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
