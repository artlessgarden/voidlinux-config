#!/usr/bin/env python3
"""选中词（非空选区）并进入 caret。"""
from __future__ import annotations

import os
import re
import time

FIFO = os.environ["QUTE_FIFO"]
HTML = os.environ.get("QUTE_SELECTED_HTML", "")


def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def main() -> int:
    m = re.search(r'data-qute-wid=["\']?(\d+)', HTML)
    if not m:
        cmd('message-warning "未找到词标记"')
        cmd("jseval -q -f --world main unwrap-words.js")
        return 0

    wid = m.group(1)
    # 选区 + 清包装一次做完，再进 caret
    cmd(
        "jseval -q --world main "
        f"(function(){{var el=document.querySelector('span.qute-word[data-qute-wid=\"{wid}\"]');"
        "if(!el)return;"
        "document.querySelectorAll('span.qute-word').forEach(function(s){"
        "if(s!==el)s.replaceWith(document.createTextNode(s.textContent||''));});"
        "var text=el.textContent||'';if(!text){el.remove();return;}"
        "var tn=document.createTextNode(text);el.replaceWith(tn);"
        "var r=document.createRange();r.setStart(tn,0);r.setEnd(tn,text.length);"
        "var sel=window.getSelection();sel.removeAllRanges();sel.addRange(r);"
        "try{tn.parentElement&&tn.parentElement.scrollIntoView({block:'center',inline:'nearest'})}catch(e){}"
        "delete document.documentElement.dataset.quteWordsWrapped;"
        "delete document.documentElement.dataset.quteWordsCount;"
        "})()"
    )
    time.sleep(0.05)
    cmd("mode-enter caret")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
