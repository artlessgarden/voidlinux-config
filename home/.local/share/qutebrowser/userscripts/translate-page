    if(e.target.closest('#qute-learn-bar')) return;
    const seg=e.target.closest('.qt-seg');
    if(!seg || !seg.querySelector('.qt-trans')) return;
    e.preventDefault();
    seg.classList.toggle('qt-hide-trans');
  });
