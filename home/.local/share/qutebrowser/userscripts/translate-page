#!/usr/bin/env python3
"""qute userscript：离线学习页（原文 / 译文 / 双语，可点切换）。

读 QUTE_HTML → 翻译文本节点 → 保留 DOM/CSS → 存 ~/Documents/qute-learn/
引擎：环境变量 QUTE_DEEPL_KEY（或 DEEPL_AUTH_KEY）→ DeepL 官方；否则 Google gtx。
"""
from __future__ import annotations

import html as html_mod
import json
import os
import re
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, as_completed
from html.parser import HTMLParser
from pathlib import Path

FIFO = os.environ["QUTE_FIFO"]
URL = os.environ.get("QUTE_URL", "")
TITLE = os.environ.get("QUTE_TITLE", "")
HTML_PATH = os.environ.get("QUTE_HTML", "")
TL_RAW = os.environ.get("QUTE_TRANS_TARGET", "zh")
TL = {"zh": "zh-CN", "zh-cn": "zh-CN", "zh_CN": "zh-CN"}.get(TL_RAW, TL_RAW)
# 有 DeepL key 就走官方免费/Pro API；否则用 Google gtx（非官方、够用但不保证）
DEEPL_KEY = (
    os.environ.get("QUTE_DEEPL_KEY")
    or os.environ.get("DEEPL_AUTH_KEY")
    or ""
).strip()

SKIP_TAGS = frozenset(
    {
        "script",
        "style",
        "noscript",
        "svg",
        "template",
        "iframe",
        "canvas",
        "code",
        "pre",
        "kbd",
        "samp",
        "title",  # <title> 不能塞 HTML 双语标签
    }
)
VOID = frozenset(
    {
        "area",
        "base",
        "br",
        "col",
        "embed",
        "hr",
        "img",
        "input",
        "link",
        "meta",
        "param",
        "source",
        "track",
        "wbr",
    }
)
MAX_CHARS = 24000
CHUNK = 4000
MARK = "⟦{}⟧"
MARK_RE = re.compile(r"⟦(\d+)⟧")
WORKERS = 4
LEARN_DIR = Path.home() / "Documents" / "qute-learn"

LEARN_CSS = """
