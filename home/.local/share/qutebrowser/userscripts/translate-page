def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def warn(msg: str) -> None:
    esc = msg.replace("\\", "\\\\").replace('"', '\\"')
    cmd(f'message-warning "{esc}"')


def info(msg: str) -> None:
    esc = msg.replace("\\", "\\\\").replace('"', '\\"')
    cmd(f'message-info "{esc}"')


def esc_attr(v: str) -> str:
    return v.replace("&", "&amp;").replace('"', "&quot;").replace("<", "&lt;")


def worth_translate(t: str) -> bool:
    s = t.strip()
    if len(s) < 2:
        return False
    if not any(c.isalpha() for c in s):
        return False
    cjk = sum(1 for c in s if "\u4e00" <= c <= "\u9fff")
    letters = sum(1 for c in s if c.isalpha())
    return not (letters and cjk / max(letters, 1) > 0.85)


def slugify(s: str) -> str:
    s = re.sub(r"\s+", " ", s).strip()
    s = re.sub(r"[^\w\u4e00-\u9fff\- ]+", "", s, flags=re.UNICODE)
    s = s.strip().replace(" ", "-")[:60]
    return s or "page"


class PageRewriter(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.parts: list[str | int] = []
        self.texts: list[str] = []
        self._skip = 0
        self._base_seen = False

    def handle_starttag(self, tag: str, attrs) -> None:
        t = tag.lower()
        if t in SKIP_TAGS:
            self._skip += 1
        if t == "base":
            self._base_seen = True
        attrs_s = "".join(
            f' {k}="{esc_attr(v)}"' for k, v in attrs if v is not None
        )
        close = " /" if t in VOID else ""
        self.parts.append(f"<{tag}{attrs_s}{close}>")
        if t == "head" and URL.startswith(("http://", "https://")) and not self._base_seen:
            self.parts.append(f'<base href="{esc_attr(URL)}">')
            self._base_seen = True

    def handle_startendtag(self, tag: str, attrs) -> None:
        t = tag.lower()
        if t == "base":
            self._base_seen = True
        attrs_s = "".join(
            f' {k}="{esc_attr(v)}"' for k, v in attrs if v is not None
        )
        self.parts.append(f"<{tag}{attrs_s} />")

    def handle_endtag(self, tag: str) -> None:
        t = tag.lower()
        if t in SKIP_TAGS and self._skip:
            self._skip -= 1
        self.parts.append(f"</{tag}>")

    def handle_data(self, data: str) -> None:
        if self._skip or not data or not data.strip():
            self.parts.append(data)
            return
        idx = len(self.texts)
        self.texts.append(data)
        self.parts.append(idx)

    def handle_entityref(self, name: str) -> None:
        self.parts.append(f"&{name};")

    def handle_charref(self, name: str) -> None:
        self.parts.append(f"&#{name};")

    def handle_comment(self, data: str) -> None:
        self.parts.append(f"<!--{data}-->")

    def handle_decl(self, decl: str) -> None:
        self.parts.append(f"<!{decl}>")

    def handle_pi(self, data: str) -> None:
        self.parts.append(f"<?{data}>")

    def render(self, translated: list[str]) -> str:
        out: list[str] = []
        for p in self.parts:
            if isinstance(p, int):
                orig = self.texts[p]
                trans = translated[p]
                if orig == trans or not worth_translate(orig):
                    out.append(html_mod.escape(orig, quote=False))
                else:
                    o = html_mod.escape(orig, quote=False)
                    t = html_mod.escape(trans, quote=False)
                    # data-* 方便以后卡片/搜索回溯
                    out.append(
                        f'<span class="qt-seg" data-orig="{esc_attr(orig.strip())}" '
                        f'data-trans="{esc_attr(trans.strip())}">'
                        f'<span class="qt-orig">{o}</span>'
                        f'<span class="qt-trans">{t}</span>'
                        f"</span>"
                    )
            else:
                out.append(p)
        return "".join(out)


def gtx_translate(text: str) -> str:
    qs = urllib.parse.urlencode(
        {"client": "gtx", "sl": "auto", "tl": TL, "dt": "t", "q": text}
    )
    req = urllib.request.Request(
        "https://translate.googleapis.com/translate_a/single?" + qs,
        headers={"User-Agent": "Mozilla/5.0"},
        method="GET",
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.loads(resp.read().decode("utf-8", errors="replace"))
    parts = data[0] or []
    return "".join(p[0] for p in parts if p and p[0])


def deepl_target() -> str:
    # DeepL: ZH = 简体中文
    t = TL.lower().replace("_", "-")
    if t in ("zh", "zh-cn", "zh-hans"):
        return "ZH"
    if t in ("zh-tw", "zh-hk", "zh-hant"):
        return "ZH"
    return TL.upper()[:5]


def deepl_endpoint() -> str:
    # 免费 key 通常以 :fx 结尾
    if DEEPL_KEY.endswith(":fx"):
        return "https://api-free.deepl.com/v2/translate"
    return "https://api.deepl.com/v2/translate"


def deepl_translate_many(texts: list[str]) -> list[str]:
    """官方 DeepL：一次多条 text=，顺序返回。"""
    if not texts:
        return []
    data = [("auth_key", DEEPL_KEY), ("target_lang", deepl_target())]
    # 保留原文格式空白
    data.append(("preserve_formatting", "1"))
    for t in texts:
        data.append(("text", t))
    body = urllib.parse.urlencode(data).encode("utf-8")
    req = urllib.request.Request(
        deepl_endpoint(),
        data=body,
        headers={
            "User-Agent": "qute-learn/1.0",
            "Content-Type": "application/x-www-form-urlencoded",
        },
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=60) as resp:
        payload = json.loads(resp.read().decode("utf-8", errors="replace"))
    outs = [x.get("text", "") for x in payload.get("translations", [])]
    if len(outs) != len(texts):
        raise ValueError("DeepL 返回条数不匹配")
    return outs


def pack_chunks(jobs: list[tuple[int, str]]) -> list[tuple[list[int], str]]:
    chunks: list[tuple[list[int], str]] = []
    ids: list[int] = []
    body_parts: list[str] = []
    size = 0
    for i, t in jobs:
        piece = f"{MARK.format(i)}\n{t}\n"
        add = len(piece)
        if ids and size + add > CHUNK:
            chunks.append((ids, "".join(body_parts)))
            ids, body_parts, size = [], [], 0
        ids.append(i)
        body_parts.append(piece)
        size += add
    if ids:
        chunks.append((ids, "".join(body_parts)))
    return chunks


def unpack(
    translated: str, expected_ids: list[int], originals: dict[int, str]
) -> dict[int, str]:
    out: dict[int, str] = {}
    matches = list(MARK_RE.finditer(translated))
    if not matches:
        return out
    for n, m in enumerate(matches):
        idx = int(m.group(1))
        start = m.end()
        end = matches[n + 1].start() if n + 1 < len(matches) else len(translated)
        frag = translated[start:end]
        orig = originals.get(idx, "")
        lead = orig[: len(orig) - len(orig.lstrip())] if orig else ""
        trail = orig[len(orig.rstrip()) :] if orig else ""
        out[idx] = lead + frag.strip() + trail
    for i in expected_ids:
        out.setdefault(i, originals[i])
    return out


def translate_batch(texts: list[str]) -> list[str]:
    result = list(texts)
    jobs: list[tuple[int, str]] = []
    used = 0
    for i, t in enumerate(texts):
        if not worth_translate(t):
            continue
        if used >= MAX_CHARS:
            break
        jobs.append((i, t))
        used += len(t)
    if not jobs:
        return result

    originals = {i: t for i, t in jobs}
    merged: dict[int, str] = {}

    if DEEPL_KEY:
        info(f"DeepL 翻译中… {len(jobs)} 段")
        # 按字数打包；DeepL 一次多条 text=
        batches: list[list[tuple[int, str]]] = []
        cur: list[tuple[int, str]] = []
        size = 0
        for i, t in jobs:
            if cur and (size + len(t) > CHUNK or len(cur) >= 40):
                batches.append(cur)
                cur, size = [], 0
            cur.append((i, t))
            size += len(t)
        if cur:
            batches.append(cur)

        def one_deepl(batch: list[tuple[int, str]]) -> dict[int, str]:
            ids = [i for i, _ in batch]
            try:
                outs = deepl_translate_many([t for _, t in batch])
            except (
                urllib.error.URLError,
                TimeoutError,
                json.JSONDecodeError,
                ValueError,
            ):
                return {i: originals[i] for i in ids}
            out: dict[int, str] = {}
            for (i, orig), tr in zip(batch, outs):
                lead = orig[: len(orig) - len(orig.lstrip())]
                trail = orig[len(orig.rstrip()) :]
                out[i] = lead + (tr or orig.strip()) + trail
            return out

        with ThreadPoolExecutor(max_workers=min(WORKERS, len(batches))) as pool:
            futs = [pool.submit(one_deepl, b) for b in batches]
            done = 0
            for fut in as_completed(futs):
                merged.update(fut.result())
                done += 1
                if len(batches) > 1:
                    info(f"DeepL… {done}/{len(batches)}")
    else:
        chunks = pack_chunks(jobs)
        info(f"gtx 翻译中… {len(jobs)} 段 / {len(chunks)} 批")

        def one_gtx(chunk: tuple[list[int], str]) -> dict[int, str]:
            ids, body = chunk
            try:
                raw = gtx_translate(body)
            except (
                urllib.error.URLError,
                TimeoutError,
                json.JSONDecodeError,
                ValueError,
            ):
                return {i: originals[i] for i in ids}
            return unpack(raw, ids, originals)

        with ThreadPoolExecutor(max_workers=min(WORKERS, len(chunks))) as pool:
            futs = [pool.submit(one_gtx, c) for c in chunks]
            done = 0
            for fut in as_completed(futs):
                merged.update(fut.result())
                done += 1
                if len(chunks) > 1:
                    info(f"gtx… {done}/{len(chunks)}")

    for i, t in merged.items():
        result[i] = t
    return result


def inject_learn_ui(html: str) -> str:
    # 标签栏好认：短前缀，不占地方；比 emoji 更稳（字体/搜索）
    tab_title = f"译 · {TITLE}" if TITLE else "译 · page"
    meta = (
        f'<meta name="qute-learn-url" content="{esc_attr(URL)}"/>\n'
        f'<meta name="qute-learn-title" content="{esc_attr(TITLE)}"/>\n'
        f'<meta name="qute-learn-tl" content="{esc_attr(TL)}"/>\n'
        f"<style>{LEARN_CSS}</style>\n"
    )
    bar = (
        '<div id="qute-learn-bar" contenteditable="false">'
        f'<span class="qt-meta" title="{esc_attr(URL)}">{html_mod.escape(tab_title)}</span>'
        '<button type="button" data-mode="orig">原文</button>'
        '<button type="button" data-mode="trans">译文</button>'
        '<button type="button" data-mode="bi" aria-pressed="true">双语</button>'
        "</div>\n"
    )
    script = f"<script>{LEARN_JS}</script>\n"
    title_tag = f"<title>{html_mod.escape(tab_title)}</title>\n"

    if re.search(r"<meta[^>]+charset", html, re.I) is None:
        if "<head>" in html.lower():
            html = re.sub(r"(?i)<head>", "<head><meta charset=\"utf-8\">", html, count=1)
        else:
            html = '<meta charset="utf-8">\n' + html

    # 覆盖/写入 <title>
    if re.search(r"(?i)<title\b[^>]*>.*?</title>", html, re.S):
        html = re.sub(
            r"(?i)<title\b[^>]*>.*?</title>",
            title_tag.strip(),
            html,
            count=1,
            flags=re.S,
        )
    elif re.search(r"(?i)<head>", html):
        html = re.sub(r"(?i)<head>", "<head>\n" + title_tag, html, count=1)
    else:
        html = title_tag + html

    if re.search(r"(?i)<head>", html):
        html = re.sub(r"(?i)</head>", meta + "</head>", html, count=1)
    else:
        html = meta + html

    if re.search(r"(?i)<body\b", html):

        def _body_open(m: re.Match[str]) -> str:
            tag = m.group(0)
            if re.search(r"(?i)\bclass\s*=", tag):
                return re.sub(
                    r'(?i)class\s*=\s*"([^"]*)"',
                    r'class="\1 qt-mode-bi"',
                    tag,
                    count=1,
                )
            return tag[:-1] + ' class="qt-mode-bi">'

        html = re.sub(r"(?i)<body\b[^>]*>", _body_open, html, count=1)
        html = re.sub(r"(?i)(<body\b[^>]*>)", r"\1" + bar, html, count=1)
    else:
        html = bar + html

    if re.search(r"(?i)</body>", html):
        html = re.sub(r"(?i)</body>", script + "</body>", html, count=1)
    else:
        html = html + script
    return html


def save_path() -> Path:
    LEARN_DIR.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    name = f"{stamp}-{slugify(TITLE)}.html"
    return (LEARN_DIR / name).resolve()


def main() -> int:
    if not HTML_PATH or not Path(HTML_PATH).is_file():
        warn("没有页面 HTML（QUTE_HTML）")
        return 0
    if not URL.startswith(("http://", "https://")):
        warn("当前页不是 http(s)")
        return 0

    info("读取页面…")
    raw = Path(HTML_PATH).read_text(encoding="utf-8", errors="replace")
    rewriter = PageRewriter()
    try:
        rewriter.feed(raw)
        rewriter.close()
    except Exception as e:  # noqa: BLE001
        warn(f"解析 HTML 失败: {e}")
        return 0

    if not rewriter.texts:
        warn("没有可译文本")
        return 0

    nchars = sum(len(t) for t in rewriter.texts)
    info(f"约 {len(rewriter.texts)} 段 / {nchars} 字")
    if nchars > MAX_CHARS:
        info(f"过长，只译前约 {MAX_CHARS} 字")

    translated = translate_batch(rewriter.texts)
    out_html = inject_learn_ui(rewriter.render(translated))

    path = save_path()
    path.write_text(out_html, encoding="utf-8")
    # 再写一份临时，方便立刻打开（同内容）
    tmp = Path(tempfile.gettempdir()) / f"qute-learn-{os.getpid()}.html"
    tmp.write_text(out_html, encoding="utf-8")

    cmd(f"open -t {path}")
    info(f"已保存学习页（原文/译文/双语）→ {path}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
