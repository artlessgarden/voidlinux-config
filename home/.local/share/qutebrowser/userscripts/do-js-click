#!/usr/bin/env python3
"""hint 选中后：一次 jseval 真点，或按 MODE 打开链接。"""
from __future__ import annotations

import os
import re
import sys

FIFO = os.environ["QUTE_FIFO"]
HTML = os.environ.get("QUTE_SELECTED_HTML", "")
URL = os.environ.get("QUTE_URL", "").strip()
MODE = (sys.argv[1] if len(sys.argv) > 1 else "current").strip()


def cmd(msg: str) -> None:
    with open(FIFO, "a", encoding="utf-8") as f:
        f.write(msg.rstrip() + "\n")


def open_url(url: str) -> None:
    safe = url.replace(" ", "%20")
    if MODE == "tab":
        cmd(f"open -t {safe}")
    elif MODE == "tab-bg":
        cmd(f"open -b {safe}")
    elif MODE == "tab-fg":
        cmd(f"open -t {safe}")
    elif MODE == "window":
        cmd(f"open -w {safe}")
    else:
        cmd(f"open {safe}")


def main() -> int:
    m = re.search(r'data-qute-cid=["\']?(\d+)', HTML)
    if not m:
        cmd('message-warning "未找到可点标记"')
        cmd("jseval -q -f --world main unmark-clickables.js")
        return 0

    if URL and MODE in ("tab", "tab-bg", "tab-fg", "window"):
        open_url(URL)
        cmd("jseval -q -f --world main unmark-clickables.js")
        return 0

    cid = m.group(1)
    # 一整段，无竞态、无 /tmp
    cmd(
        "jseval -q --world main "
        f"(function(){{var el=document.querySelector('[data-qute-cid=\"{cid}\"]');"
        "if(!el)return;"
        "var o={bubbles:true,cancelable:true,composed:true,view:window,buttons:1,button:0};"
        "['pointerdown','mousedown','pointerup','mouseup','click'].forEach(function(t){"
        "try{el.dispatchEvent(new MouseEvent(t,o))}catch(e){}});"
        "try{el.click()}catch(e){}"
        "document.querySelectorAll('[data-qute-cid]').forEach(function(n){delete n.dataset.quteCid});"
        "})()"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
