#!/usr/bin/env python3
"""Open qute via IPC (no PyQt). Same new-window path as in-app Ctrl+N."""
import getpass
import hashlib
import json
import os
import socket
import sys

_PROTOCOL = 1


def _ipc_paths():
    digest = hashlib.md5(getpass.getuser().encode()).hexdigest()
    name = f"ipc-{digest}"
    uid = os.getuid()
    bases = []
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        bases.append(runtime)
    bases.extend((f"/run/user/{uid}", f"/tmp/xdg-runtime-{uid}"))
    seen = set()
    for base in bases:
        path = os.path.join(base, "qutebrowser", name)
        if path not in seen:
            seen.add(path)
            yield path


def _send(args):
    payload = (
        json.dumps(
            {
                "args": args,
                "target_arg": "",
                "protocol_version": _PROTOCOL,
                "cwd": os.getcwd(),
            }
        )
        + "\n"
    ).encode()
    for path in _ipc_paths():
        if not os.path.exists(path):
            continue
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            sock.settimeout(0.2)
            sock.connect(path)
            sock.sendall(payload)
            return True
        except OSError:
            continue
        finally:
            sock.close()
    return False


def main():
    args = sys.argv[1:]
    if _send(args):
        return
    os.execvp("qutebrowser", ["qutebrowser", *args])


if __name__ == "__main__":
    main()
