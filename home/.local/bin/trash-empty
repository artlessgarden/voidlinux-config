#!/bin/sh
# 清空 Freedesktop 回收站（gio trash --empty 需要 gvfs）
set -eu

trash=${XDG_DATA_HOME:-$HOME/.local/share}/Trash

count=$(find "$trash/files" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l)
if [ "$count" -eq 0 ]; then
	printf '回收站已是空的。\n'
	exit 0
fi

printf '删除回收站里的 %s 项？[y/N] ' "$count"
read -r ans
case $ans in
y | Y) ;;
*) exit 0 ;;
esac

find "$trash/files" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
find "$trash/info" -mindepth 1 -maxdepth 1 -name '*.trashinfo' -exec rm -f -- {} +
printf '回收站已清空。\n'
