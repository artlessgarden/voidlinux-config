#!/bin/sh
# 便签开关：只一个 sticky 窗；未开→开，已开未聚焦→聚焦，已聚焦→关
set -eu

info=$(
	niri msg -j windows 2>/dev/null |
		tr '{' '\n' |
		grep '"title":"sticky","app_id":"Alacritty"' |
		head -n 1
) || true

if [ -n "${info:-}" ]; then
	id=$(printf '%s' "$info" | sed -n 's/^"id":\([0-9][0-9]*\),.*/\1/p')
	case $info in
	*"\"is_focused\":true"*)
		exec niri msg action close-window --id "$id"
		;;
	*)
		exec niri msg action focus-window --id "$id"
		;;
	esac
fi

mkdir -p "$HOME/notes"
touch "$HOME/notes/sticky"
exec alacritty -o window.dynamic_title=false -T sticky -e vis "$HOME/notes/sticky"
