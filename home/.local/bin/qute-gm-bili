#!/bin/sh
# 下载上游 bilibili-cleaner，拼上 qute shim → data/greasemonkey
set -e
url=${QUTE_BILI_CLEANER_URL:-https://raw.githubusercontent.com/festoney8/bilibili-cleaner/release/bilibili-cleaner.github.user.js}
cfg=${QUTE_CONFIG_DIR:-$HOME/.config/qutebrowser}
shim=$cfg/gm-src/bili-cleaner-qute.js
out=$HOME/.local/share/qutebrowser/greasemonkey/bilibili-cleaner.user.js

[ -f "$shim" ] || {
	echo "missing shim: $shim" >&2
	exit 1
}

tmp=$(mktemp)
trap 'rm -f "$tmp" "$tmp.up"' EXIT
curl -fsSL "$url" -o "$tmp.up"

mkdir -p "$(dirname "$out")"
{
	cat "$shim"
	printf '\n// ---- upstream (header stripped) ----\n'
	awk '
		/^\/\/ ==UserScript==$/ { skip=1; next }
		skip && /^\/\/ ==\/UserScript==$/ { skip=0; next }
		!skip { print }
	' "$tmp.up"
} >"$tmp"
mv "$tmp" "$out"
trap - EXIT
echo "wrote $out"
echo "qute 里 :greasemonkey-reload"
