#!/usr/bin/env bash
set -u

title="音量"
body=""
timeout=500
hint=()
replace=()
status=0
runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
[ -d "$runtime_dir" ] || runtime_dir=/tmp
id_file="$runtime_dir/osd-volume-$UID.id"

case "${1:-}" in
	up)
		amixer set Master 2%+ >/dev/null 2>&1 || status=1
		;;
	down)
		amixer set Master 2%- >/dev/null 2>&1 || status=1
		;;
	mute)
		amixer set Master toggle >/dev/null 2>&1 || status=1
		;;
	*)
		echo "usage: osd-volume {up|down|mute}" >&2
		exit 2
		;;
esac

if [ "$status" -ne 0 ]; then
	body="amixer 找不到 Master"
	timeout=1800
else
	read -r volume state < <(
		amixer get Master | awk -F'[][]' '/%/ { print $2, $4; exit }'
	)
	value="${volume%\%}"

	if [ -z "$value" ] || [ "$value" = "$volume" ]; then
		body="无法读取音量"
		timeout=1800
		status=1
	elif [ "${state:-}" = "off" ]; then
		body="静音"
		hint=(-h int:value:0)
	else
		body="$volume"
		hint=(-h "int:value:$value")
	fi
fi

if read -r old_id <"$id_file" 2>/dev/null && [[ "$old_id" =~ ^[0-9]+$ ]]; then
	replace=(-r "$old_id")
fi

new_id="$(
	notify-send -p -e -a osd -t "$timeout" \
		"${replace[@]}" "${hint[@]}" "$title" "$body" 2>/dev/null
)" || true
if [[ "$new_id" =~ ^[0-9]+$ ]]; then
	printf '%s\n' "$new_id" >"$id_file"
fi
exit "$status"
