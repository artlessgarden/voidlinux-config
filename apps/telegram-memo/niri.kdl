// Telegram memo: independent full-height column, no focus steal on launch.
window-rule {
    match app-id="^telegram-memo$"
    open-focused false
    default-column-width { proportion 0.382; }
}
// Start once per niri login; hot-reloading this file does not launch it again.
spawn-at-startup "sh" "-c" "exec \"$HOME/.local/bin/telegram-memo\""
