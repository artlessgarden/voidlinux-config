// Telegram memo: independent full-height column, no focus steal on launch.
window-rule {
    match app-id="^telegram-memo$"
    open-focused false
    default-column-width { proportion 0.382; }
}
// Start the background waiter at login; open the editor only after Telegram.
spawn-at-startup "sh" "-c" "exec \"$HOME/.local/bin/telegram-memo\" --watch"
binds {
    Mod+Shift+Z repeat=false { spawn "sh" "-c" "exec \"$HOME/.local/bin/telegram-memo\" --toggle"; }
}
