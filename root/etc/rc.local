#!/bin/sh
# ASUS 电池上限和安静档，开机恢复。
battery=/sys/class/power_supply/BAT0/charge_control_end_threshold
profile=/sys/firmware/acpi/platform_profile
[ ! -w "$battery" ] || printf '80\n' > "$battery"
[ ! -w "$profile" ] || printf 'quiet\n' > "$profile"
# ASUS Wi-Fi 模块按需安装，未安装不执行。
[ ! -x /etc/rc.local.d/asus-wifi ] || /etc/rc.local.d/asus-wifi
